# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3001

# Powers the /api/chat endpoint. Without it, chat replies with a 500.
OPENAI_API_KEY=

# Powers the /api/enquiry endpoint (sends the project brief by email via Gmail SMTP).
# SMTP_APP_PASSWORD is a Gmail "app password", not the account password.
SMTP_USER=
SMTP_APP_PASSWORD=
RECIPIENT_EMAIL=
